{
  "name": "cmsmanager",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-tinymce": "node scripts/copy-tinymce.mjs",
    "start": "npm run copy-tinymce && vite",
    "dev": "npm run copy-tinymce && vite",
    "build": "npm run copy-tinymce && tsc -b && vite build",
    "watch": "npm run copy-tinymce && vite build --watch --mode development",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@tinymce/tinymce-react": "^6.3.1",
    "bootstrap": "^5.3.9",
    "font-awesome": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tinymce": "^8.10.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
